#!/bin/sh -e
#
# /etc/rc.local - runs as root at the end of every boot. Installed by update.sh.
#
# Starts the BirdNET-Pi display: waits 60 s (network, BirdNET-Pi), then runs
# the main script as user pi with the Pimoroni Python, in the background,
# logging to display.log.
#   Watch:  tail -f /home/pi/bbbb/custom_display/display.log
#   Stop:   sudo pkill -f bbbb-display.py
(
  sleep 60
  sudo -u pi sh -c 'cd /home/pi/bbbb/custom_display && \
    /home/pi/.virtualenvs/pimoroni/bin/python3 -u /home/pi/bbbb/custom_display/bbbb-display.py \
    >> /home/pi/bbbb/custom_display/display.log 2>&1'
) &

exit 0
